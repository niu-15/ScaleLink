<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色主题：低饱和蓝灰 -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#3E5C6B</item>
        <item name="android:colorPrimaryDark">#2C4450</item>
        <item name="android:colorAccent">#3E5C6B</item>
        <item name="android:windowBackground">#F4F6F8</item>
        <item name="android:statusBarColor">#F4F6F8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">#141B1F</item>
        <item name="android:textColorSecondary">#5F6C73</item>
    </style>

    <!-- 深色主题 -->
    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#7C9BAA</item>
        <item name="android:colorPrimaryDark">#0F1417</item>
        <item name="android:colorAccent">#7C9BAA</item>
        <item name="android:windowBackground">#0F1417</item>
        <item name="android:statusBarColor">#0F1417</item>
        <item name="android:navigationBarColor">#0F1417</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#E8EDF0</item>
        <item name="android:textColorSecondary">#A2AEB6</item>
    </style>
</resources>
